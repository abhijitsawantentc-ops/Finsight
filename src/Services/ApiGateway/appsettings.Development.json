{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "marketdata-route": {
        "ClusterId": "marketdata-cluster",
        "Match": {
          "Path": "/api/market-data/{**catch-all}"
        }
      },
      "portfolio-route": {
        "ClusterId": "portfolio-cluster",
        "Match": {
          "Path": "/api/portfolios/{**catch-all}"
        }
      },
      "risk-route": {
        "ClusterId": "risk-cluster",
        "Match": {
          "Path": "/api/risk/{**catch-all}"
        }
      },
      "notifications-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5010"
          }
        }
      },
      "marketdata-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5020"
          }
        }
      },
      "portfolio-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5030"
          }
        }
      },
      "risk-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5041"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5050"
          }
        }
      }
    }
  }
}
