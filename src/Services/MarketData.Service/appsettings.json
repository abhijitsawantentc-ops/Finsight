{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "quant_broker",
    "Password": "QuantBrokerPass123!"
  },
  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },
  "MarketData": {
    "Providers": {
      "Finnhub": {
        "ApiKey": "",
        "BaseUrl": "https://finnhub.io/api/v1/"
      },
      "AlphaVantage": {
        "ApiKey": "",
        "BaseUrl": "https://www.alphavantage.co/"
      },
      "EnableSandboxFallback": true
    },
    "RateLimiting": {
      "Finnhub": {
        "PermitLimit": 30,
        "WindowSeconds": 60,
        "QueueLimit": 0
      },
      "AlphaVantage": {
        "PermitLimit": 5,
        "WindowSeconds": 60,
        "QueueLimit": 0
      }
    },
    "Resilience": {
      "Finnhub": {
        "MaxRetryAttempts": 2,
        "InitialRetryDelayMs": 300,
        "TimeoutSeconds": 3,
        "FailureRatio": 0.5,
        "MinimumThroughput": 3,
        "SamplingDurationSeconds": 15,
        "BreakDurationSeconds": 20
      },
      "AlphaVantage": {
        "MaxRetryAttempts": 2,
        "InitialRetryDelayMs": 400,
        "TimeoutSeconds": 4,
        "FailureRatio": 0.5,
        "MinimumThroughput": 3,
        "SamplingDurationSeconds": 15,
        "BreakDurationSeconds": 20
      }
    },
    "Caching": {
      "HotCacheTtlSeconds": 60,
      "StaleCacheTtlHours": 24
    }
  }
}
